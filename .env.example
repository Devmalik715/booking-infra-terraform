# Copy to .env before running docker compose if you want to change the defaults.
#   cp .env.example .env
#
# These credentials are local-only. Nothing in this repo ships a real secret:
# on AWS the RDS master password is generated by RDS itself and read from
# Secrets Manager by the ECS task (see infra/modules/rds/main.tf).
POSTGRES_DB=bookings
POSTGRES_USER=bookings_app
POSTGRES_PASSWORD=local_dev_password

# Host port the database is published on. Change it if 5432 is already in use.
HOST_PORT=5432

# Where backup.sh writes dumps to.
BACKUP_DIR=./backups
